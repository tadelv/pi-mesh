!.env.example
.pi-mesh/
*.tsbuildinfo

# Review inputs produced while a change is under review: never source, and
# `git add -A` has swept one into a commit twice.
.review-*.patch

# A global core.excludesFile carrying `/Packages` (e.g. an Xcode setup) matches
# this monorepo's `packages/` on a case-insensitive filesystem, silently ignoring
# every new file under it while leaving tracked files editable. A repo
# .gitignore outranks core.excludesFile, so re-include the directory here.
!packages/
